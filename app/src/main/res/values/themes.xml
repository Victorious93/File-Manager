<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme: dark widgets in every system mode, so the splash, the frames before Compose draws and any
         platform dialog are never white (Don dislikes white screens; the app defaults to the dark fleet look).
         A user who picks Light in Settings still gets light Compose screens. The public name is split off so
         values-v31 can add the splash attribute. -->
    <style name="Base.Theme.VictoriousFileManager" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="Theme.VictoriousFileManager" parent="Base.Theme.VictoriousFileManager" />
    <!-- MainActivity's manifest theme: only the launch window carries the logo. onCreate switches to
         Theme.VictoriousFileManager before the window is built, so the logo is not left behind the UI
         (it would show through during keyboard resizes). -->
    <style name="Theme.VictoriousFileManager.Starting" parent="Theme.VictoriousFileManager">
        <item name="android:windowBackground">@drawable/launch_window</item>
    </style>
    <!-- Translucent window for PanelActivity: the host app stays visible behind the sheet. -->
    <style name="Theme.VictorFiles.Panel" parent="Theme.VictoriousFileManager">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
