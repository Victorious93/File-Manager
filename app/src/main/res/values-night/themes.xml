<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark system mode: same launch window as values/, with dark Material widgets. Only the Base style is
         redefined here; Theme.VictoriousFileManager must not be, or it would shadow the values-v31 one. -->
    <style name="Base.Theme.VictoriousFileManager" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
