<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <queries>
        <package android:name="ai.droidcommand.app" />
        <package android:name="ai.droidcommand.app.debug" />
    </queries>

    <application
        android:name=".FileManagerApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VictoriousFileManager">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.VictoriousFileManager"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Optional RootForge-style Messenger stub. Exported, no signature
            permission, no DependencyGuard. Binding does not grant LIVE control.
            Hub recognition requires a later droidcommand-AI PR.
        -->
        <service
            android:name=".fleet.FileManagerBridgeService"
            android:exported="true">
            <intent-filter>
                <action android:name="ai.victorious.filemanager.action.BRIDGE" />
            </intent-filter>
        </service>
    </application>
</manifest>
