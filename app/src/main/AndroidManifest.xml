<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- App Manager usage stats (granted by the user in Settings > Usage access). -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Phase 12: background audio playback via Media3 MediaSessionService. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Fleet: full-screen approve/deny prompt for held remote requests. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- App manager lists/backs up every installed app; a <queries> allowlist cannot express that. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <queries>
        <package android:name="ai.droidcommand.app" />
        <package android:name="ai.droidcommand.app.debug" />
        <package android:name="com.victorious.keyboard.debug" />
        <package android:name="moe.shizuku.privileged.api" />
        <!-- Fleet theme: VictorLaunch's read-only theme provider. -->
        <package android:name="com.victorious.launch" />
        <provider android:authorities="com.victorious.launch.theme" />
        <intent>
            <action android:name="rikka.shizuku.intent.action.REQUEST_PERMISSION" />
        </intent>
    </queries>

    <!-- largeHeap: the APK/DEX tools load whole classes*.dex files (dexlib2 needs byte arrays);
         on a default heap, Smali tools on a multi-dex APK ran out of memory. -->
    <application
        android:name=".FileManagerApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VictoriousFileManager">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.VictoriousFileManager.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <activity
            android:name=".media.MediaProActivity"
            android:exported="false"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:launchMode="singleTask"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden"
            android:theme="@style/Theme.VictoriousFileManager" />

        <activity
            android:name=".fleet.RemoteConfirmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity="${applicationId}.confirm"
            android:theme="@style/Theme.VictoriousFileManager" />

        <!-- Right-edge sheet for host apps (VictorSuite's swipe-out drawer). Same UI as MainActivity,
             grants the caller no file access, so it is exported without caller gating.
             See docs/VICTORSUITE_PANEL.md. -->
        <activity
            android:name=".panel.PanelActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.VictorFiles.Panel"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="ai.victorious.filemanager.action.PANEL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Shizuku library provider (documented by Shizuku-API). Not a fleet BIND_* permission. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <receiver
            android:name=".apk.InstallResultReceiver"
            android:exported="false" />

        <!-- Messenger bridge: callers are checked in code (package allowlist + optional cert pins,
             external control off by default), see docs/FLEET_BRIDGE.md. -->
        <service
            android:name=".fleet.FileManagerBridgeService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="ai.victorious.filemanager.action.BRIDGE" />
            </intent-filter>
        </service>

        <!-- Phase 12 — Media & viewers -->
        <service
            android:name=".media.AudioPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".widget.BookmarksWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_bookmarks_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bookmarks_widget_info" />
        </receiver>

        <service
            android:name=".tiles.OpenFileManagerTileService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/tile_open_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".tiles.WifiTransferTileService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/tile_wifi_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <activity
            android:name=".share.ShareReceiverActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/share_save_label"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".cloud.CloudAuthRedirectActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${oauthRedirectScheme}" android:host="oauth2redirect" />
            </intent-filter>
        </activity>

        <!-- Fleet theme wake-up from VictorLaunch (sent explicitly to this package). Exported; it only
             triggers a re-query, which verifies the provider's package and signing cert. -->
        <receiver
            android:name=".ui.theme.fleet.FleetThemeChangedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.victorious.launch.action.FLEET_THEME_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
